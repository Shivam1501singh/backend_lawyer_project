datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  USER
  ADVOCATE
  CONTENT_CREATOR
  ADMIN
}

enum AdvocateStatus {
  ACTIVE
  BLOCKED
}

enum AdvocateApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  CONNECTED
  REJECTED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  LOGIN
}

model RegistrationSession {
  id                   String            @id @default(uuid())
  accountType          AccountType
  fullName             String
  email                String?
  emailVerified        Boolean           @default(false)
  city                 String?
  state                String?
  pincode              String?
  phone                String?
  phoneVerified        Boolean           @default(false)
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  
  otpVerifications     OtpVerification[]

  aadhaarVerified             Boolean           @default(false)
  aadhaarVerificationAttempts  Int               @default(0)
  aadhaarBlockedUntil         DateTime?
  aadhaarVerificationId       String?
  aadhaarVerifiedAt           DateTime?
  aadhaarVerificationMethod   String?

  // Temporary advocate registration details
  profilePhotoUrl      String?
  profilePhotoPublicId String?
  gender               String?
  barCouncilId         String?
  aadhaarNumber        String?
  passwordHash         String?
  languagesSpoken      String[]          @default([])
  country              String?
  latitude             Float?
  longitude            Float?
}

model OtpVerification {
  id             String               @id @default(uuid())
  registrationId String?
  accountType    AccountType
  purpose        OtpPurpose
  target         String
  otpHash        String
  expiresAt      DateTime
  attempts       Int                  @default(0)
  maxAttempts    Int                  @default(5)
  used           Boolean              @default(false)
  createdAt      DateTime             @default(now())

  registration   RegistrationSession? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([target])
  @@index([expiresAt])
}

model User {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  phone         String   @unique
  city          String
  state         String
  pincode       String
  emailVerified Boolean  @default(true)
  phoneVerified Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  latitude      Float?
  longitude     Float?

  reviews         Review[]
  savedLawyers    SavedLawyer[]
  likedAdvocates  AdvocateLike[]
  caseRequests    CaseConnectionRequest[]
  caseConnections CaseConnection[]
}

model Advocate {
  id                       String   @id @default(uuid())
  profilePhotoUrl          String?
  profilePhotoPublicId     String?
  fullName                 String
  phone                    String   @unique
  phoneVerified            Boolean  @default(false)
  gender                   String?
  barCouncilId             String   @unique
  aadhaarNumber            String?
  email                    String   @unique
  emailVerified            Boolean  @default(false)
  passwordHash             String
  languagesSpoken          String[]
  country                  String?  // India-specific platform; country is optional
  state                    String
  city                     String
  pincode                  String?
  isActive                 Boolean        @default(true)
  status                   AdvocateStatus @default(ACTIVE)
  approvalStatus           AdvocateApprovalStatus @default(PENDING)
  rejectionReason          String?
  submittedForApprovalAt   DateTime?
  approvedAt               DateTime?
  approvedById             String?
  rejectedAt               DateTime?
  rejectedById             String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime @updatedAt

  // Professional profile fields
  experienceYears          Int?
  casesWon                 Int?
  bestPracticeArea         String?
  about                    String?
  courtPractice            String[]
  completeAddress          String?
  videoCallChargePerMinute Decimal?
  voiceCallChargePerMinute Decimal?
  offlineVisitingFee       Decimal?

  averageRating            Decimal?
  totalReviews             Int               @default(0)
  reviews                  Review[]

  aadhaarVerified             Boolean           @default(false)
  aadhaarVerificationAttempts  Int               @default(0)
  aadhaarBlockedUntil         DateTime?
  aadhaarVerificationId       String?
  aadhaarVerifiedAt           DateTime?
  aadhaarVerificationMethod   String?

  practiceAreas            String[]          @default([])
  topCourtPractised        String?
  latitude                 Float?
  longitude                Float?
  savedBy                  SavedLawyer[]
  likes                    AdvocateLike[]
  caseRequests             CaseConnectionRequest[]
  caseConnections          CaseConnection[]

  sentTeamRequests     AdvocateTeamRequest[] @relation("SentTeamRequests")
  receivedTeamRequests AdvocateTeamRequest[] @relation("ReceivedTeamRequests")
  teamMatesPrimary     AdvocateTeamMate[]    @relation("TeamMatesPrimary")
  teamMatesSecondary   AdvocateTeamMate[]    @relation("TeamMatesSecondary")
}

enum TeamRequestStatus {
  PENDING
  VERIFIED
  EXPIRED
  CANCELLED
}

enum HelpRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model HelpRequest {
  id           String            @id @default(uuid())
  referenceId  String            @unique

  name         String
  email        String
  phoneNumber  String            @default("")
  concern      String            @db.Text
  response     String?           @db.Text

  status       HelpRequestStatus @default(OPEN)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  respondedAt  DateTime?

  @@index([email])
  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(uuid())
  userId      String
  advocateId  String
  rating      Int
  reviewText  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  advocate    Advocate  @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  @@index([advocateId])
  @@index([userId])
  @@index([createdAt])

  @@unique([userId, advocateId])
}

model SavedLawyer {
  id         String   @id @default(uuid())
  userId     String
  advocateId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  advocate   Advocate @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  @@unique([userId, advocateId])
  @@index([userId])
  @@index([advocateId])
}

model AdvocateLike {
  id         String   @id @default(uuid())
  userId     String
  advocateId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  advocate   Advocate @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  @@unique([userId, advocateId])
  @@index([userId])
  @@index([advocateId])
}

model AdvocateTeamRequest {
  id                  String            @id @default(uuid())
  requesterAdvocateId String
  targetAdvocateId    String
  status              TeamRequestStatus @default(PENDING)
  otpHash             String
  otpExpiresAt        DateTime
  otpAttempts         Int               @default(0)
  maxOtpAttempts      Int               @default(5)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  requesterAdvocate   Advocate          @relation("SentTeamRequests", fields: [requesterAdvocateId], references: [id], onDelete: Cascade)
  targetAdvocate      Advocate          @relation("ReceivedTeamRequests", fields: [targetAdvocateId], references: [id], onDelete: Cascade)

  @@index([requesterAdvocateId])
  @@index([targetAdvocateId])
  @@index([status])
}

model AdvocateTeamMate {
  id          String   @id @default(uuid())
  advocateId  String
  teamMateId  String
  createdAt   DateTime @default(now())

  advocate    Advocate @relation("TeamMatesPrimary", fields: [advocateId], references: [id], onDelete: Cascade)
  teamMate    Advocate @relation("TeamMatesSecondary", fields: [teamMateId], references: [id], onDelete: Cascade)

  @@unique([advocateId, teamMateId])
  @@index([advocateId])
  @@index([teamMateId])
}



model ContentCreator {
  id           String   @id @default(uuid())
  fullName     String   @default("Content Creator")
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  image        String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  blogs        Blog[]
}

model Blog {
  id            String         @id @default(uuid())
  image         String?
  imagePublicId String?
  heading       String
  title         String
  date          DateTime
  writtenBy     String
  content       String         @db.Text
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  slug            String?        @unique

  authorId      String
  author        ContentCreator  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
}

model Admin {
  id           String   @id @default(uuid())
  fullName     String   @default("Admin")
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CaseConnectionRequest {
  id          String                   @id @default(uuid())
  userId      String
  advocateId  String
  note        String                   @db.Text
  description String                   @db.Text
  status      RequestStatus            @default(PENDING)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  advocate    Advocate                 @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  attachments CaseRequestAttachment[]
  connection  CaseConnection?

  @@index([userId])
  @@index([advocateId])
  @@index([status])
  @@index([createdAt])
}

model CaseRequestAttachment {
  id        String                @id @default(uuid())
  requestId String
  fileUrl   String
  publicId  String?
  fileType  String?
  fileName  String?
  createdAt DateTime              @default(now())

  request   CaseConnectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model CaseConnection {
  id         String                @id @default(uuid())
  requestId  String                @unique
  userId     String
  advocateId String
  createdAt  DateTime              @default(now())

  request    CaseConnectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  advocate   Advocate              @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([advocateId])
}
